# Read automatically by docker compose, so these survive a restart.
# Passing CAMERA_SET only on the command line does not: the container
# comes back on the compose default.

# Which camera-sets/<name>.json the backend loads.
#   chandigarh -> 14 hand-placed junctions, 73 edges  (the default demo)
#   tricity    -> 50 generated junctions, 268 edges   (needs its graph
#                 reloaded from generated/camera-edges-tricity.sql)
CAMERA_SET=chandigarh

# Host port for Postgres. 5432 is often already taken on this machine.
DB_PORT=55432
